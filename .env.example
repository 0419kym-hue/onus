# 이 파일을 .env.local로 복사합니다. 둘 다 비어 있으면 로컬 예시 모드입니다.
# Supabase 프로젝트의 Connect 화면에서 Project URL과 Publishable key를 확인합니다.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# 선택: 직접 만든 Google Form의 응답 링크. 비어 있으면 지원 버튼을 비활성화합니다.
NEXT_PUBLIC_APPLICATION_FORM_URL=

# 선택: ON:US AI 공모전 추천(서버에서만 사용, 절대 NEXT_PUBLIC_ 접두사를 붙이지 않습니다).
OPENAI_API_KEY=
# 선택: true 로 두면 AI 추천을 끕니다(해커톤 트랙 규정상 AI를 쓰면 안 될 때).
ONUS_AI_DISABLED=
